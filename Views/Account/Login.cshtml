@model TeacherReporter.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Login — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .card {
            background: #16213e;
            padding: 40px;
            border-radius: 10px;
            width: 100%;
            max-width: 400px;
            border: 1px solid #0f3460;
        }
        h2 {
            text-align: center;
            margin-bottom: 8px;
            color: #e94560;
            font-size: 1.8rem;
        }
        .subtitle {
            text-align: center;
            color: #888;
            margin-bottom: 28px;
            font-size: 0.9rem;
        }
        .form-group { margin-bottom: 18px; }
        label {
            display: block;
            margin-bottom: 6px;
            color: #aaa;
            font-size: 0.85rem;
        }
        input[type=email], input[type=password] {
            width: 100%;
            padding: 10px 14px;
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 0.95rem;
            outline: none;
            transition: border 0.2s;
        }
        input:focus { border-color: #e94560; }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            color: #aaa;
            font-size: 0.85rem;
        }
        .btn {
            width: 100%;
            padding: 12px;
            background: #e94560;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn:hover { background: #c73652; }
        .error {
            background: #3a1a1a;
            border: 1px solid #e94560;
            color: #e94560;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 0.85rem;
        }
        .link {
            text-align: center;
            margin-top: 20px;
            font-size: 0.85rem;
            color: #888;
        }
        .link a { color: #e94560; text-decoration: none; }
        .link a:hover { text-decoration: underline; }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<div class="card">
    <h2>TeacherReporter</h2>
    <p class="subtitle">Войдите в свой аккаунт</p>

    @if (Context.Request.Query["reason"] == "deactivated")
    {
        <div class="error">
            Ваш аккаунт был деактивирован администратором.
        </div>
    }
    @if (Context.Request.Query["reason"] == "deleted")
    {
        <div class="error">
            Ваш аккаунт удален. Пожалуйста, свяжитесь с администратором.
        </div>
    }

    @if (Context.Request.Query["reason"] == "timeout")
    {
        <div class="error" style="background:#1a2e3a;
        border-color:#57c8ff; color:#57c8ff;">
            ⏱ Ваша сессия истекла из-за бездействия. Пожалуйста, войдите снова.
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error">
            @foreach (var error in ViewData.ModelState.Values
                          .SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>Email</label>
            <input type="email" name="Email" value="@Model?.Email" placeholder="teacher@spt.com"/>
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input type="password" name="Password" placeholder="••••••"/>
        </div>
        <div class="checkbox-group">
            <input type="checkbox" name="RememberMe" id="remember" value="true"/>
            <input type="hidden" name="RememberMe" value="false"/>
            <label for="remember">Запомнить меня</label>
        </div>
        <button type="submit" class="btn">Войти</button>
    </form>

    <div class="link">
        У вас нет аккаунта? <a href="/Account/Register">Зарегистрируйтесь здесь</a>
    </div>
    <div class="link" style="margin-top: 10px;">
        Нужна помощь? <a href="/Support/Chat">Связаться со службой поддержки</a>
    </div>
</div>

<div style="position:fixed; top:16px; right:16px;">
    <button class="theme-toggle-btn"
            onclick="toggleTheme()"
            style="background:transparent; border:1px solid #0f3460;
                   border-radius:8px; padding:6px 10px;
                   cursor:pointer; font-size:1rem;"
            title="Переключить тему">☀️</button>
</div>

</body>
</html>