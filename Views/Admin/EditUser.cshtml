@model TeacherReporter.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    Layout = null;
    TimeZoneInfo krasZone;
    try { krasZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Russia TZ 6 Standard Time"); }
    catch { try { krasZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Asia/Krasnoyarsk"); }
    catch { krasZone = TimeZoneInfo.CreateCustomTimeZone("Krasnoyarsk",
        TimeSpan.FromHours(7), "Krasnoyarsk Time",
        "Krasnoyarsk Standard Time"); } }
    DateTime ToKras(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), krasZone);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Edit User — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .navbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo { color: #e94560; font-size: 1.3rem; font-weight: bold; }
        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-outline {
            background: transparent;
            color: #aaa;
            border: 1px solid #0f3460;
        }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .btn-primary { background: #e94560; color: white; }
        .btn-primary:hover { background: #c73652; }
        .btn-warning {
            background: #3a2e1a;
            color: #ffc857;
            border: 1px solid #ffc857;
        }
        .btn-warning:hover { background: #ffc857; color: #1a1a2e; }
        .container {
            max-width: 640px;
            margin: 40px auto;
            padding: 0 24px;
            display: flex;
            flex-direction: column;
            gap: 22px;
        }
        .card {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 12px;
            padding: 28px 32px;
        }
        .card-title {
            font-size: 1rem;
            font-weight: 600;
            color: #e94560;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #0f3460;
        }
        .profile-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 20px;
        }
        .avatar {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: #e94560;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            font-weight: bold;
            color: white;
            flex-shrink: 0;
        }
        .profile-meta p { color: #666; font-size: 0.82rem; margin-top: 3px; }
        .stats-row {
            display: flex;
            gap: 14px;
            margin-bottom: 20px;
        }
        .stat {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 8px;
            padding: 10px 16px;
            text-align: center;
            flex: 1;
        }
        .stat .num {
            font-size: 1.3rem;
            font-weight: bold;
            color: #e94560;
        }
        .stat .lbl { font-size: 0.72rem; color: #666; margin-top: 2px; }
        .role-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #1a2e3a;
            color: #57c8ff;
            border: 1px solid #57c8ff;
        }
        .role-badge.admin {
            background: #3a0f1a;
            color: #e94560;
            border-color: #e94560;
        }
        .form-group { margin-bottom: 18px; }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        label {
            display: block;
            color: #aaa;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }
        input[type=text], input[type=email] {
            width: 100%;
            padding: 10px 14px;
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 0.92rem;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: #e94560; }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            font-size: 0.88rem;
            color: #aaa;
        }
        input[type=checkbox] { accent-color: #e94560; width: 16px; height: 16px; }
        .validation-error {
            color: #e94560;
            font-size: 0.78rem;
            margin-top: 4px;
        }
        .error-list {
            background: #3a1a1a;
            border: 1px solid #e94560;
            color: #e94560;
            padding: 10px 16px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 0.85rem;
        }
        .btn-row {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        form { margin: 0; }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<nav class="navbar">
    <div class="logo">📊 TeacherReporter</div>
    <a href="/Admin" class="btn btn-outline">← Панель администратора</a>
</nav>

<div class="container">

    <!-- User Overview -->
    <div class="card">
        <div class="profile-header">
            <div class="avatar">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <div class="profile-meta">
                <strong>@Model.FullName</strong>
                <p>@Model.Email</p>
                <div style="margin-top:6px;">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="role-badge @(role == "Admin" ? "admin" : "")">
                            @role
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat">
                <div class="num">@Model.SheetCount</div>
                <div class="lbl">Таблицы</div>
            </div>
            <div class="stat">
                <div class="num">
                    @ToKras(Model.CreatedAt).ToString("dd MMM yyyy")
                </div>
                <div class="lbl">Регистрация</div>
            </div>
            <div class="stat">
                <div class="num">
                    @(Model.LastLoginAt.HasValue
                        ? ToKras(Model.LastLoginAt.Value).ToString("dd MMM, HH:mm")
                        : "Never")
                </div>
                <div class="lbl">Последний вход</div>
            </div>
            <div class="stat">
                <div class="num">
                    @(Model.IsActive ? "Active" : "Inactive")
                </div>
                <div class="lbl">Статус</div>
            </div>
        </div>
    </div>

    <!-- Edit Info -->
    <div class="card">
        <div class="card-title">✏️ Редактировать данные</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-list">
                @foreach (var error in ViewData.ModelState.Values
                              .SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" action="/Admin/EditUser">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id"/>
            <input type="hidden" name="CreatedAt"
                   value="@Model.CreatedAt.ToString("o")"/>
            <input type="hidden" name="SheetCount"
                   value="@Model.SheetCount"/>

            <div class="form-row">
                <div class="form-group">
                    <label>Полное имя</label>
                    <input type="text" name="FullName"
                           value="@Model.FullName" required/>
                    @if (ViewData.ModelState["FullName"]?
                             .Errors.Any() == true)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["FullName"]!
                            .Errors.First().ErrorMessage
                        </div>
                    }
                </div>
                <div class="form-group">
                    <label>Электронная почта</label>
                    <input type="email" name="Email"
                           value="@Model.Email" required/>
                    @if (ViewData.ModelState["Email"]?
                             .Errors.Any() == true)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["Email"]!
                            .Errors.First().ErrorMessage
                        </div>
                    }
                </div>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" name="IsActive"
                       id="isActive" value="true"
                       @(Model.IsActive ? "checked" : "")/>
                <input type="hidden" name="IsActive" value="false"/>
                <label for="isActive">Аккаунт активен</label>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">
                    Сохранить изменения
                </button>
                <a href="/Admin/UserSheets?userId=@Model.Id"
                   class="btn btn-outline">
                    Таблицы
                </a>
                <a href="/Admin/ResetPassword?userId=@Model.Id"
                   class="btn btn-warning">
                    🔑 Сбросить пароль
                </a>
            </div>
        </form>
    </div>

</div>

@await Html.PartialAsync("_SessionWarning")

</body>
</html>