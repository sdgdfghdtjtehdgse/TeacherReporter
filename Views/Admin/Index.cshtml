@model TeacherReporter.ViewModels.AdminStatsViewModel
@{
    ViewData["Title"] = "Admin Panel";
    Layout = null;
    TimeZoneInfo krasZone;
    try
    {
        krasZone = TimeZoneInfo.FindSystemTimeZoneById("Russia TZ 6 Standard Time");
    }
    catch
    {
        try
        {
            krasZone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Krasnoyarsk");
        }
        catch
        {
            // Manual UTC+7 fallback if no timezone ID works
            krasZone = TimeZoneInfo.CreateCustomTimeZone(
                "Krasnoyarsk",
                TimeSpan.FromHours(7),
                "Krasnoyarsk Time (UTC+7)",
                "Krasnoyarsk Standard Time"
            );
        }
    }
    DateTime ToKras(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), krasZone);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Admin Panel — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .navbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .navbar .logo { color: #e94560; font-size: 1.3rem; font-weight: bold; }
        .nav-right { display: flex; align-items: center; gap: 12px; }
        .badge-admin {
            background: #e94560;
            color: white;
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 20px;
            font-weight: 600;
            letter-spacing: 0.05em;
        }
        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-outline { background: transparent; color: #aaa; border: 1px solid #0f3460; }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .btn-danger { background: #3a1a1a; color: #e94560; border: 1px solid #e94560; font-size: 0.8rem; padding: 5px 12px; }
        .btn-danger:hover { background: #e94560; color: white; }
        .btn-ban { background: #2a0a0a; color: #ff4444; border: 1px solid #ff4444; font-size: 0.8rem; padding: 5px 12px; }
        .btn-ban:hover { background: #ff4444; color: white; }
        .btn-warning { background: #3a2e1a; color: #ffc857; border: 1px solid #ffc857; font-size: 0.8rem; padding: 5px 12px; }
        .btn-warning:hover { background: #ffc857; color: #1a1a2e; }
        .btn-info { background: #1a2e3a; color: #57c8ff; border: 1px solid #57c8ff; font-size: 0.8rem; padding: 5px 12px; }
        .btn-info:hover { background: #57c8ff; color: #1a1a2e; }
        .btn-success { background: #1a3a2e; color: #57ffb0; border: 1px solid #57ffb0; font-size: 0.8rem; padding: 5px 12px; }
        .btn-success:hover { background: #57ffb0; color: #1a1a2e; }
        .container { max-width: 1100px; margin: 36px auto; padding: 0 24px; }
        h1 { font-size: 1.4rem; margin-bottom: 24px; color: #e0e0e0; }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 36px;
        }
        .stat-card {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 10px;
            padding: 22px;
            text-align: center;
        }
        .stat-card .number {
            font-size: 2.2rem;
            font-weight: bold;
            color: #e94560;
        }
        .stat-card .label {
            font-size: 0.8rem;
            color: #666;
            margin-top: 6px;
        }
        .section-title {
            font-size: 1rem;
            color: #aaa;
            margin-bottom: 14px;
            padding-bottom: 8px;
            border-bottom: 1px solid #0f3460;
        }
        .error-msg {
            background: #3a1a1a;
            border: 1px solid #e94560;
            color: #e94560;
            padding: 10px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.85rem;
        }
        .success-msg {
            background: #1a3a2e;
            border: 1px solid #57ffb0;

            color: #57ffb0;
            padding: 10px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.85rem;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }
        thead tr {
            background: #16213e;
            border-bottom: 2px solid #0f3460;
        }
        thead th {
            padding: 12px 14px;
            text-align: left;
            color: #aaa;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        tbody tr {
            border-bottom: 1px solid #0f3460;
            transition: background 0.15s;
        }
        tbody tr:hover { background: #16213e; }
        tbody td { padding: 12px 14px; vertical-align: middle; }
        .role-badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 600;
        }
        .unread-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #e94560;
            color: white;
            font-size: 0.65rem;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            border-radius: 20px;
            padding: 0 5px;
            margin-left: 4px;
            vertical-align: middle;
            line-height: 1;
        }
        .btn-export {
            background: transparent;
            color: #57ffb0;
            border: 1px solid #57ffb0;
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s, color 0.2s;
        }
        .btn-export:hover {
            background: #57ffb0;
            color: #1a1a2e;
        }
        .role-admin { background: #3a0f1a; color: #e94560; border: 1px solid #e94560; }
        .role-teacher { background: #1a2e3a; color: #57c8ff; border: 1px solid #57c8ff; }
        .status-active { color: #57ffb0; font-size: 0.8rem; }
        .status-inactive { color: #e94560; font-size: 0.8rem; }
        .actions { display: flex; gap: 6px; flex-wrap: wrap; }
        form { display: inline; }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<nav class="navbar">
    <div class="logo">📊 TeacherReporter</div>
    <div class="nav-right">
        <button class="theme-toggle-btn btn btn-outline"
                onclick="toggleTheme()" title="Переключить тему">☀️</button>
        <span class="badge-admin">ADMIN</span>
        <a href="/Admin/BannedUsers" class="btn btn-outline">☠ Заблокированные</a>
        <a href="/Admin/Support" class="btn btn-outline">
            💬 Поддержка
            @if (ViewBag.UnreadSupportCount > 0)
            {
                <span class="unread-badge">@ViewBag.UnreadSupportCount</span>
            }
        </a>
        <a href="/Spreadsheet" class="btn btn-outline">← Мои таблицы</a>
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline">Выйти</button>
        </form>
    </div>
</nav>

<div class="container">
    <div style="display:flex; justify-content:space-between;
                align-items:center; margin-bottom:0;">
        <h1>Панель администратора</h1>
        <a href="/Admin/ExportUsers"
           class="btn btn-export">
            📥 Экспорт пользователей
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="error-msg">⚠️ @TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="success-msg">✅ @TempData["Success"]</div>
    }

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="number">@Model.TotalUsers</div>
            <div class="label">Всего пользователей</div>
        </div>
        <div class="stat-card">
            <div class="number">@Model.TotalTeachers</div>
            <div class="label">Учителей</div>
        </div>
        <div class="stat-card">
            <div class="number">@Model.ActiveUsers</div>
            <div class="label">Активных аккаунтов</div>
        </div>
        <div class="stat-card">
            <div class="number">@Model.TotalSheets</div>
            <div class="label">Сохранённых таблиц</div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="section-title">Все пользователи</div>
    <table>
        <thead>
        <tr>
            <th>Имя</th>
            <th>Почта</th>
            <th>Роль</th>
            <th>Статус</th>
            <th>Таблицы</th>
            <th>Регистрация</th>
            <th>Последний вход</th>
            <th>Действия</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    @foreach (var role in user.Roles)
                    {
                        <span class="role-badge @(role == "Admin" ? "role-admin" : "role-teacher")">
                            @role
                        </span>
                    }
                </td>
                <td>
                    @if (user.IsActive)
                    {
                        <span class="status-active">● Активен</span>
                    }
                    else
                    {
                        <span class="status-inactive">● Неактивен</span>
                    }
                </td>
                <td>@user.SheetCount</td>
                <td>@ToKras(user.CreatedAt).ToString("dd MMM yyyy, HH:mm")</td>
                <td>
                    @(user.LastLoginAt.HasValue
                        ? ToKras(user.LastLoginAt.Value).ToString("dd MMM yyyy, HH:mm")
                        : "—")
                </td>
                <td>
                    <div class="actions">
                        <a href="/Admin/EditUser?userId=@user.Id" class="btn btn-success">✏️ Изменить</a>
                        <a href="/Admin/UserSheets?userId=@user.Id" class="btn btn-info">Таблицы</a>

                        <form method="post" action="/Admin/ToggleActive">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id"/>
                            <button type="submit" class="btn btn-warning">
                                @(user.IsActive ? "Деактивировать" : "Активировать")
                            </button>
                        </form>

                        <form method="post" action="/Admin/DeleteUser"
                              onsubmit="return confirm('Удалить @user.FullName и все его таблицы? Это необратимо.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id"/>
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </form>
                        <form method="post" action="/Admin/BanUser"
                              onsubmit="return confirm('НАВСЕГДА заблокировать @user.FullName? Он не сможет зарегистрироваться с тем же email или IP.')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id"/>
                            <button type="submit" class="btn btn-ban">☠ Заблокировать</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<script>
    // Poll unread support count every 10 seconds
    setInterval(async function () {
        try {
            const res = await fetch('/Admin/UnreadCount');
            if (!res.ok) return;
            const data = await res.json();
            const badges = document.querySelectorAll('.unread-badge');
            badges.forEach(function (b) { b.remove(); });

            if (data.count > 0) {
                document.querySelectorAll('a[href="/Admin/Support"]')
                    .forEach(function (link) {
                        const badge = document.createElement('span');
                        badge.className = 'unread-badge';
                        badge.textContent = data.count;
                        link.appendChild(badge);
                    });
            }
        } catch (e) { /* silent fail */ }
    }, 10000);
</script>

@await Html.PartialAsync("_SessionWarning")

</body>
</html>