@model TeacherReporter.ViewModels.AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Reset Password — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .card {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 12px;
            padding: 36px 40px;
            width: 100%;
            max-width: 440px;
        }
        .card-icon { font-size: 2rem; text-align: center; margin-bottom: 10px; }
        h2 {
            text-align: center;
            color: #e94560;
            font-size: 1.4rem;
            margin-bottom: 6px;
        }
        .subtitle {
            text-align: center;
            color: #666;
            font-size: 0.82rem;
            margin-bottom: 26px;
        }
        .form-group { margin-bottom: 18px; }
        label {
            display: block;
            color: #aaa;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }
        input[type=password] {
            width: 100%;
            padding: 10px 14px;
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 0.92rem;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: #e94560; }
        .btn {
            width: 100%;
            padding: 11px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.95rem;
            text-align: center;
            text-decoration: none;
            display: block;
            transition: background 0.2s;
            margin-bottom: 10px;
        }
        .btn-primary { background: #e94560; color: white; }
        .btn-primary:hover { background: #c73652; }
        .btn-outline {
            background: transparent;
            color: #aaa;
            border: 1px solid #0f3460;
        }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .error-list {
            background: #3a1a1a;
            border: 1px solid #e94560;
            color: #e94560;
            padding: 10px 16px;
            border-radius: 6px;
            margin-bottom: 16px;
            font-size: 0.85rem;
        }
        .validation-error {
            color: #e94560;
            font-size: 0.78rem;
            margin-top: 4px;
        }
        .warning-box {
            background: #3a2e1a;
            border: 1px solid #ffc857;
            color: #ffc857;
            padding: 10px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.82rem;
            line-height: 1.5;
        }
        .strength-bar-wrap {
            height: 4px;
            background: #0f3460;
            border-radius: 2px;
            margin-top: 6px;
            overflow: hidden;
        }
        .strength-bar {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.3s, background 0.3s;
        }
        .strength-label {
            font-size: 0.72rem;
            margin-top: 4px;
            min-height: 14px;
            transition: color 0.3s;
        }
    </style>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<div class="card">
    <div class="card-icon">🔑</div>
    <h2>Сброс пароля</h2>
    <p class="subtitle">Установка нового пароля для <strong>@Model.FullName</strong></p>

    <div class="warning-box">
        Пользователь должен будет использовать этот новый пароль при следующем входе. 
        Обязательно сообщите ему об этом.
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-list">
            @foreach (var error in ViewData.ModelState.Values
                          .SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post" action="/Admin/ResetPassword">
        @Html.AntiForgeryToken()
        <input type="hidden" name="UserId" value="@Model.UserId"/>
        <input type="hidden" name="FullName" value="@Model.FullName"/>

        <div class="form-group">
            <label>Новый пароль</label>
            <input type="password" name="NewPassword"
                   id="admin-password"
                   placeholder="••••••" required
                   oninput="checkStrength(this.value, 'admin')"/>
            <div class="strength-bar-wrap">
                <div class="strength-bar" id="admin-strength-bar"></div>
            </div>
            <div class="strength-label" id="admin-strength-label"></div>
        </div>

        <div class="form-group">
            <label>Подтвердите новый пароль</label>
            <input type="password" name="ConfirmPassword"
                   placeholder="••••••" required/>
            @if (ViewData.ModelState["ConfirmPassword"]?
                     .Errors.Any() == true)
            {
                <div class="validation-error">
                    @ViewData.ModelState["ConfirmPassword"]!
                    .Errors.First().ErrorMessage
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">
            Установить новый пароль
        </button>
        <a href="/Admin/EditUser?userId=@Model.UserId"
           class="btn btn-outline">
            Отмена
        </a>
    </form>
</div>

<script>
    function checkStrength(password, prefix) {
        var bar   = document.getElementById(prefix + '-strength-bar');
        var label = document.getElementById(prefix + '-strength-label');
        if (!bar || !label) return;

        if (password.length === 0) {bar.style.width = '0%';
            label.textContent = '';
            return;
        }

        var score = 0;
        var tips  = [];

        if (password.length >= 6)  score++;
        if (password.length >= 10) score++;
        if (password.length >= 14) score++;

        if (/[a-z]/.test(password)) score++;
        if (/[A-Z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^a-zA-Z0-9]/.test(password)) score++;

        if (password.length < 10)          tips.push('длиннее');
        if (!/[A-Z]/.test(password))        tips.push('верхний регистр');
        if (!/[0-9]/.test(password))        tips.push('числа');
        if (!/[^a-zA-Z0-9]/.test(password)) tips.push('символы');

        var pct, color, text;

        if (score <= 2) {
            pct = 20; color = '#ff4444'; text = '🔴 Слабый';
        } else if (score <= 3) {
            pct = 40; color = '#ff7700'; text = '🟠 Такой-се';
        } else if (score <= 4) {
            pct = 60; color = '#ffc857'; text = '🟡 Умеренный';
        } else if (score <= 5) {
            pct = 80; color = '#57c8ff'; text = '🔵 Сильный';
        } else {
            pct = 100; color = '#57ffb0'; text = '🟢 Очень сильный';
        }

        if (tips.length > 0 && score < 6)
            text += '  · попробуйте добавить: ' + tips.join(', ');

        bar.style.width      = pct + '%';
        bar.style.background = color;
        label.style.color    = color;
        label.textContent    = text;
    }
</script>

</body>
</html>