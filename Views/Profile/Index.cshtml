@model TeacherReporter.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = null;
    TimeZoneInfo krasZone;
    try { krasZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Russia TZ 6 Standard Time"); }
    catch { try { krasZone = TimeZoneInfo.FindSystemTimeZoneById(
        "Asia/Krasnoyarsk"); }
    catch { krasZone = TimeZoneInfo.CreateCustomTimeZone("Krasnoyarsk",
        TimeSpan.FromHours(7), "Krasnoyarsk Time",
        "Krasnoyarsk Standard Time"); } }
    DateTime ToKras(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc, DateTimeKind.Utc), krasZone);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>My Profile — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .navbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo { color: #e94560; font-size: 1.3rem; font-weight: bold; }
        .nav-right { display: flex; align-items: center; gap: 12px; }
        .btn {
            padding: 8px 16px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-outline {
            background: transparent;
            color: #aaa;
            border: 1px solid #0f3460;
        }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .btn-primary { background: #e94560; color: white; border: none; }
        .btn-primary:hover { background: #c73652; }
        .btn-danger {
            background: #3a1a1a;
            color: #e94560;
            border: 1px solid #e94560;
        }
        .btn-danger:hover { background: #e94560; color: white; }
        .container {
            max-width: 740px;
            margin: 40px auto;
            padding: 0 24px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
        .card {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 12px;
            padding: 28px 32px;
        }
        .card-title {
            font-size: 1rem;
            font-weight: 600;
            color: #e94560;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #0f3460;
        }
        .profile-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
        }
        .avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #e94560;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            font-weight: bold;
            color: white;
            flex-shrink: 0;
        }
        .profile-info h2 {
            font-size: 1.2rem;
            margin-bottom: 4px;
        }
        .profile-info p {
            color: #666;
            font-size: 0.82rem;
        }
        .stats-row {
            display: flex;
            gap: 20px;
            margin-top: 12px;
        }
        .stat {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 8px;
            padding: 12px 18px;
            text-align: center;
            flex: 1;
        }
        .stat .num {
            font-size: 1.5rem;
            font-weight: bold;
            color: #e94560;
        }
        .stat .lbl {
            font-size: 0.75rem;
            color: #666;
            margin-top: 2px;
        }
        .role-badge {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            background: #1a2e3a;
            color: #57c8ff;
            border: 1px solid #57c8ff;
            margin-top: 4px;
        }
        .role-badge.admin {
            background: #3a0f1a;
            color: #e94560;
            border-color: #e94560;
        }
        .form-group { margin-bottom: 18px; }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        label {
            display: block;
            color: #aaa;
            font-size: 0.82rem;
            margin-bottom: 6px;
        }
        input[type=text],
        input[type=email],
        input[type=password] {
            width: 100%;
            padding: 10px 14px;
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 0.92rem;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus { border-color: #e94560; }
        .msg {
            padding: 10px 16px;
            border-radius: 6px;
            font-size: 0.85rem;
            margin-bottom: 16px;
        }
        .msg.success {
            background: #1a3a2e;
            border: 1px solid #57ffb0;
            color: #57ffb0;
        }
        .msg.error {
            background: #3a1a1a;
            border: 1px solid #e94560;
            color: #e94560;
        }
        .danger-zone {
            border-color: #e94560 !important;
        }
        .danger-zone .card-title { color: #e94560; }
        .danger-text {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 16px;
            line-height: 1.6;
        }
        .delete-row {
            display: flex;
            gap: 12px;
            align-items: flex-end;
        }
        .delete-row .form-group { flex: 1; margin-bottom: 0; }
        .validation-error {
            color: #e94560;
            font-size: 0.78rem;
            margin-top: 4px;
        }
        .strength-bar-wrap {
            height: 4px;
            background: #0f3460;
            border-radius: 2px;
            margin-top: 6px;
            overflow: hidden;
        }
        .strength-bar {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.3s, background 0.3s;
        }
        .strength-label {
            font-size: 0.72rem;
            margin-top: 4px;
            min-height: 14px;
            transition: color 0.3s;
        }
        form { margin: 0; }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<nav class="navbar">
    <div class="logo">📊 TeacherReporter</div>
    <div class="nav-right">
        <button class="theme-toggle-btn btn btn-outline"
                onclick="toggleTheme()" title="Toggle Theme">☀️</button>
        <a href="/Spreadsheet" class="btn btn-outline">← Мои таблицы</a>
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin/Index" class="btn btn-outline">Панель администратора</a>
        }
        <form method="post" action="/Account/Logout" style="margin:0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline">Выйти</button>
        </form>
    </div>
</nav>

<div class="container">

    <!-- Profile Overview Card -->
    <div class="card">
        <div class="profile-header">
            <div class="avatar">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <div class="profile-info">
                <h2>@Model.FullName</h2>
                <p>@Model.Email</p>
                <div class="role-badge @(Model.CurrentRole == "Admin" ? "admin" : "")">
                    @Model.CurrentRole
                </div>
            </div>
        </div>
        <div class="stats-row">
            <div class="stat">
                <div class="num">@Model.SheetCount</div>
                <div class="lbl">Таблицы</div>
            </div>
            <div class="stat">
                <div class="num">
                    @ToKras(Model.CreatedAt).ToString("dd MMM yyyy")
                </div>
                <div class="lbl">Дата регистрации</div>
            </div>
            <div class="stat">
                <div class="num">
                    @(Model.LastLoginAt.HasValue
                        ? ToKras(Model.LastLoginAt.Value).ToString("dd MMM yyyy")
                        : "—")
                </div>
                <div class="lbl">Дата последнего входа</div>
            </div>
            <div class="stat">
                <div class="num">
                    @(Model.LastLoginAt.HasValue
                        ? ToKras(Model.LastLoginAt.Value).ToString("HH:mm")
                        : "—")
                </div>
                <div class="lbl">Время последнего входа</div>
            </div>
        </div>
    </div>

    <!-- Update Info Card -->
    <div class="card">
        <div class="card-title">✏️ Редактировать профиль</div>

        @if (TempData["Success"] != null)
        {
            <div class="msg success">✅ @TempData["Success"]</div>
        }

        <form method="post" action="/Profile/UpdateInfo">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SheetCount"
                   value="@Model.SheetCount"/>
            <input type="hidden" name="CurrentRole"
                   value="@Model.CurrentRole"/>
            <input type="hidden" name="CreatedAt"
                   value="@Model.CreatedAt.ToString("o")"/>

            <div class="form-row">
                <div class="form-group">
                    <label>Полное имя</label>
                    <input type="text" name="FullName"
                           value="@Model.FullName" required/>
                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState["FullName"]?.Errors.Any() == true)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["FullName"]!
                            .Errors.First().ErrorMessage
                        </div>
                    }
                </div>
                <div class="form-group">
                    <label>Электронная почта</label>
                    <input type="email" name="Email"
                           value="@Model.Email" required/>
                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState["Email"]?.Errors.Any() == true)
                    {
                        <div class="validation-error">
                            @ViewData.ModelState["Email"]!
                            .Errors.First().ErrorMessage
                        </div>
                    }
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                Сохранить изменения
            </button>
        </form>
    </div>

    <!-- Change Password Card -->
    <div class="card">
        <div class="card-title">🔒 Изменить пароль</div>

        @if (TempData["PasswordSuccess"] != null)
        {
            <div class="msg success">✅ @TempData["PasswordSuccess"]</div>
        }
        @if (TempData["PasswordError"] != null)
        {
            <div class="msg error">⚠️ @TempData["PasswordError"]</div>
        }

        <form method="post" action="/Profile/ChangePassword">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Текущий пароль</label>
                <input type="password" name="CurrentPassword"
                       placeholder="••••••" required/>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Новый пароль</label>
                    <input type="password" name="NewPassword"
                           id="profile-password"
                           placeholder="••••••" required
                           oninput="checkStrength(this.value, 'profile')"/>
                    <div class="strength-bar-wrap">
                        <div class="strength-bar" id="profile-strength-bar"></div>
                    </div>
                    <div class="strength-label" id="profile-strength-label"></div>
                </div>
                <div class="form-group">
                    <label>Подтвердите новый пароль</label>
                    <input type="password" name="ConfirmPassword"
                           placeholder="••••••" required/>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">
                Изменить пароль
            </button>
        </form>
    </div>

    <!-- Danger Zone Card -->
    <div class="card danger-zone">
        <div class="card-title">⚠️ Опасная зона</div>
        <p class="danger-text">
            Безвозвратное удаление аккаунта и всех ваших таблиц. 
            Это действие необратимо.
        </p>

        @if (TempData["DeleteError"] != null)
        {
            <div class="msg error">⚠️ @TempData["DeleteError"]</div>
        }

        <form method="post" action="/Profile/DeleteAccount"
              onsubmit="return confirm(
                'Вы уверены? Это безвозвратно удалит ваш аккаунт и ВСЕ ваши таблицы.')">
            @Html.AntiForgeryToken()
            <div class="delete-row">
                <div class="form-group">
                    <label>Введите пароль для подтверждения</label>
                    <input type="password" name="password"
                           placeholder="••••••" required/>
                </div>
                <button type="submit" class="btn btn-danger">
                    Удалить мой аккаунт
                </button>
            </div>
        </form>
    </div>

</div>

<script>
    function checkStrength(password, prefix) {
        var bar   = document.getElementById(prefix + '-strength-bar');
        var label = document.getElementById(prefix + '-strength-label');
        if (!bar || !label) return;

        if (password.length === 0) {bar.style.width = '0%';
            label.textContent = '';
            return;
        }

        var score = 0;
        var tips  = [];

        if (password.length >= 6)  score++;
        if (password.length >= 10) score++;
        if (password.length >= 14) score++;

        if (/[a-z]/.test(password)) score++;
        if (/[A-Z]/.test(password)) score++;
        if (/[0-9]/.test(password)) score++;
        if (/[^a-zA-Z0-9]/.test(password)) score++;

        if (password.length < 10)          tips.push('длиннее');
        if (!/[A-Z]/.test(password))        tips.push('верхний регистр');
        if (!/[0-9]/.test(password))        tips.push('числа');
        if (!/[^a-zA-Z0-9]/.test(password)) tips.push('символы');

        var pct, color, text;

        if (score <= 2) {
            pct = 20; color = '#ff4444'; text = '🔴 Слабый';
        } else if (score <= 3) {
            pct = 40; color = '#ff7700'; text = '🟠 Такой-се';
        } else if (score <= 4) {
            pct = 60; color = '#ffc857'; text = '🟡 Умеренный';
        } else if (score <= 5) {
            pct = 80; color = '#57c8ff'; text = '🔵 Сильный';
        } else {
            pct = 100; color = '#57ffb0'; text = '🟢 Очень сильный';
        }

        if (tips.length > 0 && score < 6)
            text += '  · попробуйте добавить: ' + tips.join(', ');

        bar.style.width      = pct + '%';
        bar.style.background = color;
        label.style.color    = color;
        label.textContent    = text;
    }
</script>

@await Html.PartialAsync("_SessionWarning")

</body>
</html>