    <div id="spreadsheet"></div>
</div>
<div id="tab-bar"></div>

<div class="toast" id="toast"></div>

<!-- Скрытый токен защиты от подделки запросов fetch. -->
<form id="af-form" style="display:none">
    @Html.AntiForgeryToken()
</form>

<script src="/lib/xlsx/xlsx.full.min.js"></script>
<script src="/lib/pdfmake/pdfmake.min.js"></script>
<script src="/lib/pdfmake/vfs_fonts.js"></script>

<script>
    window.SHEET_ID_INIT = @sheetIdVal;
    window.DATA_JSON_RAW = @Html.Raw(
                               System.Text.Json.JsonSerializer.Serialize(dataJsonVal)
                           );
</script>
<script src="/js/editor.js"></script>
<script>
    startLoading();

    var colorLegendActive = false;

    function toggleColorLegend() {
        colorLegendActive = !colorLegendActive;

        var legend = document.getElementById('legend');
        var btn    = document.getElementById('btn-color-legend');

        if (colorLegendActive) {
            if (legend) legend.style.display = 'flex';
            if (btn)    btn.classList.add('active');
            if (typeof colorCodeAllCells === 'function')
                colorCodeAllCells();
        } else {
            if (legend) legend.style.display = 'none';
            if (btn)    btn.classList.remove('active');
            removeColorCoding();
        }
    }

    function removeColorCoding() {
        var tbody = document.querySelector(
            '#spreadsheet .jexcel tbody');
        if (!tbody) return;
        var rows = tbody.querySelectorAll('tr');
        rows.forEach(function (row, y) {
            var cells = row.querySelectorAll('td');
            cells.forEach(function (cell, x) {
                if (x === 0 || x === 1) return;
                var key = (x - 1) + ',' + y;
                var userStyle = (typeof cellStyles !== 'undefined'
                    && cellStyles[key]) ? cellStyles[key] : {};
                if (!userStyle.color) {
                    cell.style.removeProperty('color');
                    cell.style.setProperty('color',
                        'var(--text-primary, #e0e0e0)', 'important');
                }
                if (!userStyle.bold)
                    cell.style.removeProperty('font-weight');
            });
        });
    }
</script>
<script>
    async function pollEditorBell() {
        try {
            var res = await fetch('/Spreadsheet/UnreadSupportCount');
            if (!res.ok) return;
            var data = await res.json();
            var badge = document.getElementById('bell-badge-editor');
            var btn   = document.getElementById('bell-btn-editor');
            if (!badge || !btn) return;
            if (data.count > 0) {
                badge.textContent = data.count > 99 ? '99+' : data.count;
                badge.style.display = 'inline';
                btn.style.borderColor = '#e94560';
                btn.title = data.count + ' непрочитанный ответ от администратора';
            } else {
                badge.style.display = 'none';
                btn.style.borderColor = '';
                btn.title = 'Чат поддержки';
            }
        } catch (e) { }
    }

    pollEditorBell();
    setInterval(pollEditorBell, 15000);
</script>

@await Html.PartialAsync("_SessionWarning")

</body>
</html>