            <option value="11px">11</option>
            <option value="12px">12</option>
            <option value="14px">14</option>
            <option value="16px">16</option>
            <option value="18px">18</option>
            <option value="20px">20</option>
            <option value="24px">24</option>
        </select>
    </div>

    <div class="tool-divider"></div>

    <!-- Text Alignment -->
    <div class="tool-group">
        <button class="tool-btn" onclick="applyAlign('left')" title="По левому краю">
            &#8676;
        </button>
        <button class="tool-btn" onclick="applyAlign('center')" title="По центру">
            &#8651;
        </button>
        <button class="tool-btn" onclick="applyAlign('right')" title="Вправо">
            &#8677;
        </button>
    </div>

    <div class="tool-divider"></div>

    <!-- Text Color -->
