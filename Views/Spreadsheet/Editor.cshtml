    </div>

    <div class="tool-divider"></div>

    <!-- Undo / Redo -->
    <div class="tool-group">
        <button class="tool-btn" onclick="undoAction()" title="Отменить">↩</button>
        <button class="tool-btn" onclick="redoAction()" title="Вернуть">↪</button>
    </div>

    <div class="tool-divider"></div>

    <!-- Clear formatting -->
    <div class="tool-group">
        <button class="tool-btn" onclick="clearFormatting()"
                title="Очистить форматирование">✕ Очистить</button>
    </div>
    <div class="tool-divider"></div>
    <div class="tool-group">
        <button class="tool-btn" id="btn-color-legend"
                onclick="toggleColorLegend()"
                title="Включить/выключить цветовые обозначения оценок">
            🎨 Оценки
        </button>
    </div>
</div>

<div id="formula-bar">
    <span id="cell-address">A1</span>
    <span id="formula-divider"></span>
    <span id="fx-label">fx</span>
    <input type="text" id="formula-input" placeholder="Выберите ячейку..." readonly/>
</div>

<div id="search-bar">
    <div class="search-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="search-input"
               placeholder="Искать строку..."
