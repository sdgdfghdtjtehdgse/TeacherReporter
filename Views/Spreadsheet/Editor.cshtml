@model TeacherReporter.Models.SpreadsheetModel
@{
ViewData["Title"] = "Editor";
Layout = null;
var sheetIdVal = Model.Id;
var sheetTitleVal = Model.Id == 0 ? "Таблица без имени" : Model.Title;
var dataJsonVal = string.IsNullOrEmpty(Model.DataJson) ? "" : Model.DataJson;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Editor — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }
        .navbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }
        .logo { color: #e94560; font-weight: bold; font-size: 1.1rem; }
        #sheetTitle {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            padding: 6px 12px;
            font-size: 0.95rem;
            width: 200px;
            outline: none;
        }
        #sheetTitle:focus { border-color: #e94560; }
        .btn {
            padding: 7px 14px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.82rem;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s;
        }
        .btn-primary { background: #e94560; color: white; }
        .btn-primary:hover { background: #c73652; }
        .btn-success { background: #1a6b3c; color: #7dffb3; border: 1px solid #2a9d5c; }
        .btn-success:hover { background: #2a9d5c; color: white; }
        .btn-outline { background: transparent; color: #aaa; border: 1px solid #0f3460; }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .spacer { flex: 1; }
        .status {
            font-size: 0.78rem;
            font-style: italic;
            color: #aaa;
            padding: 3px 10px;
            border-radius: 5px;
            border: 1px solid transparent;
            transition: color 0.3s, border-color 0.3s, background 0.3s;
        }
        .status.saved {
            color: #57ffb0;
            border-color: #57ffb0;
            background: rgba(87, 255, 176, 0.07);
        }
        .status.unsaved {
            color: #ffc857;
            border-color: transparent;
            background: transparent;
        }
        #spreadsheet-container {
            flex: 1;
            overflow: auto;
            padding: 0;
            position: relative;
        }
        #loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #666;
            font-size: 1rem;
        }
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 12px 22px;
            border-radius: 8px;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            z-index: 9999;
            background: #1a6b3c;
            color: #7dffb3;
        }
        .toast.error { background: #3a1a1a; color: #e94560; }
        .toast.show { opacity: 1; }

        /* ── темная тема jspreadsheet ── */
        .jexcel_content { background: #1a1a2e !important; }

        .jexcel > thead > tr > td {
            background: #16213e !important;
            color: #e94560 !important;
            border-color: #0f3460 !important;
            font-weight: 600;
        }
        .jexcel > tbody > tr > td {
            background: #1a1a2e !important;
            color: #e0e0e0 !important;
            border-color: #0f3460 !important;
        }
        .jexcel > tbody > tr:hover > td {
            background: #16213e !important;
        }
        /* Selected cells — high contrast */
        .jexcel > tbody > tr > td.selected,
        .jexcel > tbody > tr > td.highlight,
        .jexcel > tbody > tr > td.highlight-top,
        .jexcel > tbody > tr > td.highlight-bottom,
        .jexcel > tbody > tr > td.highlight-left,
        .jexcel > tbody > tr > td.highlight-right {
            background: #1a3a5c !important;
            color: #ffffff !important;
        }

        /* Full selection border outline */
        .jexcel > tbody > tr > td.highlight-top {
            border-top: 2px solid #e94560 !important;
        }
        .jexcel > tbody > tr > td.highlight-bottom {
            border-bottom: 2px solid #e94560 !important;
        }
        .jexcel > tbody > tr > td.highlight-left {
            border-left: 2px solid #e94560 !important;
        }
        .jexcel > tbody > tr > td.highlight-right {
            border-right: 2px solid #e94560 !important;
        }

        /* Selected row number highlight */
        .jexcel > tbody > tr > td.selected:first-child {
            background: #e94560 !important;
            color: white !important;
        }

        /* Selected column header highlight */
        .jexcel > thead > tr > td.selected {
            background: #e94560 !important;
            color: white !important;
        }
        .jexcel_corner,
        .jexcel_selectall {
            background: #16213e !important;
            border-color: #0f3460 !important;
        }

        /* Разрешить цветовое кодирование JS переопределять цвет ячейки по умолчанию */
        .jexcel > tbody > tr > td[style*="color"] {
            color: inherit;
        }

        /* Оформление первой колонки в стиле заморозки */
        .jexcel > tbody > tr > td:first-child {
            background: #16213e !important;
            color: #e0e0e0 !important;
            border-right: 2px solid #e94560 !important;
            font-weight: 500;
        }
        .jexcel > tbody > tr:hover > td:first-child {
            background: #1e2d50 !important;
        }
        .jexcel > thead > tr > td:first-child {
            border-right: 2px solid #e94560 !important;
        }

        /* Исправление: изменение цвета текста внутри активной/редактируемой ячейки. */
        .jexcel > tbody > tr > td.editor input,
        .jexcel > tbody > tr > td.editor textarea,
        .jexcel > tbody > tr > td input,
        .jexcel > tbody > tr > td textarea {
            color: #e0e0e0 !important;
            background: #0f3460 !important;
            caret-color: #e0e0e0 !important;
        }

        /* поле ввода для переименования заголовка столбца */
        .jexcel > thead > tr > td input {
            color: #e94560 !important;
            background: #16213e !important;
            caret-color: #e94560 !important;
        }

        @@media print {
            .navbar { display: none !important; }
            #spreadsheet-container { overflow: visible; height: auto; }
        }

        #legend {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 6px 20px;
            display: flex;
            gap: 24px;
            flex-shrink: 0;
            font-size: 0.78rem;
            color: #aaa;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            flex-shrink: 0;
        }

        #formula-bar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 5px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            height: 36px;
        }
        #cell-address {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 4px;
            color: #e94560;
            font-family: monospace;
            font-size: 0.82rem;
            padding: 3px 10px;
            min-width: 52px;
            text-align: center;
            flex-shrink: 0;
        }
        #formula-divider {
            width: 1px;
            height: 22px;
            background: #0f3460;
            flex-shrink: 0;
        }
        #fx-label {
            color: #e94560;
            font-style: italic;
            font-family: 'Segoe UI', sans-serif;
            font-size: 0.95rem;
            flex-shrink: 0;
            font-weight: 600;
        }
        #formula-input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: #e0e0e0;
            font-family: monospace;
            font-size: 0.88rem;
            caret-color: #e94560;
            cursor: default;
        }
        #formula-input:not([readonly]) {
            cursor: text;
            border-bottom: 1px solid #e94560;
        }

        #toolbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 6px 14px;
            display: flex;
            align-items: center;
            gap: 4px;
            flex-shrink: 0;
            flex-wrap: wrap;
            min-height: 42px;
        }
        .tool-group {
            display: flex;
            align-items: center;
            gap: 2px;
        }
        .tool-btn {
            background: transparent;
            border: 1px solid transparent;
            border-radius: 4px;
            color: #aaa;
            cursor: pointer;
            font-size: 0.88rem;
            padding: 4px 8px;
            min-width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
        }
        .tool-btn:hover {
            background: #0f3460;
            border-color: #0f3460;
            color: #e0e0e0;
        }
        .tool-btn.active {
            background: #e94560;
            border-color: #e94560;
            color: white;
        }
        .tool-divider {
            width: 1px;
            height: 22px;
            background: #0f3460;
            margin: 0 6px;
            flex-shrink: 0;
        }
        #toolbar select {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 4px;
            color: #aaa;
            font-size: 0.82rem;
            padding: 3px 6px;
            height: 28px;
            outline: none;
            cursor: pointer;
        }
        #toolbar select:focus { border-color: #e94560; }
        .tool-color-label {
            position: relative;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 4px;
            border: 1px solid transparent;
            transition: background 0.15s, border-color 0.15s;
        }
        .tool-color-label:hover {
            background: #0f3460;
            border-color: #0f3460;
        }
        .tool-color-label input[type=color] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
            pointer-events: none;
        }
        .tool-color-label .color-icon {
            font-size: 0.9rem;
            font-weight: bold;
            color: #aaa;
            pointer-events: none;
        }
        #tab-bar {
            background: #16213e;
            border-top: 1px solid #0f3460;
            display: flex;
            align-items: center;
            gap: 2px;
            padding: 0 12px;
            height: 36px;
            flex-shrink: 0;
            overflow-x: auto;
            overflow-y: hidden;
        }
        #tab-bar::-webkit-scrollbar { height: 3px; }
        #tab-bar::-webkit-scrollbar-thumb { background: #0f3460; }
        .tab-item {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 4px 14px;
            border-radius: 6px 6px 0 0;
            cursor: pointer;
            font-size: 0.82rem;
            color: #666;
            border: 1px solid transparent;
            border-bottom: none;
            transition: background 0.15s, color 0.15s;
            white-space: nowrap;
            user-select: none;
        }
        .tab-item:hover { background: #0f3460; color: #aaa; }
        .tab-item.active {
            background: #1a1a2e;
            color: #e0e0e0;
            border-color: #0f3460;
        }
        .tab-close {
            font-size: 0.7rem;
            color: #555;
            cursor: pointer;
            padding: 1px 3px;
            border-radius: 3px;
            line-height: 1;
        }
        .tab-dup {
            font-size: 0.75rem;
            color: #555;
            cursor: pointer;
            padding: 1px 3px;
            border-radius: 3px;
            line-height: 1;
        }
        .tab-dup:hover { color: #57c8ff; background: rgba(87,200,255,0.15); }
        .tab-close:hover { color: #e94560; background: rgba(233,69,96,0.15); }
        .tab-rename-input {
            background: transparent;
            border: none;
            border-bottom: 1px solid #e94560;
            color: #e0e0e0;
            font-size: 0.82rem;
            outline: none;
            width: 80px;
            padding: 0 2px;
        }
        .tab-add-btn {
            background: transparent;
            border: 1px dashed #0f3460;
            border-radius: 6px;
            color: #555;
            cursor: pointer;
            font-size: 0.78rem;
            padding: 3px 10px;
            margin-left: 6px;
            transition: border-color 0.15s, color 0.15s;
            white-space: nowrap;
        }
        .tab-add-btn:hover { border-color: #e94560; color: #e94560; }
        #print-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.7);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #print-dialog {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 12px;
            padding: 28px 32px;
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        .pd-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #e94560;
            margin-bottom: 4px;
        }
        .pd-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .pd-group label {
            font-size: 0.8rem;
            color: #aaa;
        }
        .pd-group input,
        .pd-group select {
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            color: #e0e0e0;
            font-size: 0.88rem;
            padding: 8px 12px;
            outline: none;
            width: 100%;
        }
        .pd-group input:focus,
        .pd-group select:focus { border-color: #e94560; }
        .pd-row {
            display: flex;
            gap: 14px;
        }
        .pd-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 6px;
        }

        /* ── Print styles ── */
        @@media print {
            .navbar, #toolbar, #formula-bar, #legend, #tab-bar { display: none !important; }
        }
        /* jspreadsheet context menu dark theme */
        /* Force context menu contrast — override all jspreadsheet defaults */
        div.jexcel_contextmenu,
        div.jexcel_contextmenu div,
        div.jexcel_contextmenu span,
        div.jexcel_contextmenu a {
            background-color: #16213e !important;
            color: #ffffff !important;
            font-family: 'Segoe UI', sans-serif !important;
            font-size: 0.85rem !important;
        }
        div.jexcel_contextmenu {
            border: 1px solid #0f3460 !important;
            border-radius: 8px !important;
            box-shadow: 0 8px 32px rgba(0,0,0,0.6) !important;
            padding: 4px 0 !important;
            min-width: 210px !important;
        }
        div.jexcel_contextmenu div:hover {
            background-color: #0f3460 !important;
            color: #e94560 !important;
            cursor: pointer !important;
        }
        div.jexcel_contextmenu hr,
        div.jexcel_contextmenu .divisor {
            border-color: #0f3460 !important;
            margin: 4px 0 !important;
        }
        /* Category labels inside submenu */
        div.jexcel_contextmenu div[disabled],
        div.jexcel_contextmenu div.disabled {
            color: #e94560 !important;
            font-size: 0.72rem !important;
            font-weight: 700 !important;
            letter-spacing: 0.05em !important;
            pointer-events: none !important;
            cursor: default !important;
        }
        /* Submenu panel */
        div.jexcel_contextmenu div div,
        div.jexcel_contextmenu .jexcel_contextmenu_sub {
            background-color: #16213e !important;
            border: 1px solid #0f3460 !important;
            border-radius: 8px !important;
            box-shadow: 0 8px 32px rgba(0,0,0,0.6) !important;
            max-height: 360px !important;
            overflow-y: auto !important;
        }
        #search-bar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 6px 14px;
            display: flex;
            align-items: center;
            gap: 16px;
            flex-shrink: 0;
            height: 38px;
        }
        .search-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            background: #1a1a2e;
            border: 1px solid #0f3460;
            border-radius: 6px;
            padding: 4px 10px;
            width: 280px;
            transition: border-color 0.2s;
        }
        .search-wrap:focus-within { border-color: #e94560; }
        .search-icon { font-size: 0.82rem; color: #555; flex-shrink: 0; }
        #search-input {
            background: transparent;
            border: none;
            outline: none;
            color: #e0e0e0;
            font-size: 0.85rem;
            flex: 1;
            min-width: 0;
        }
        #search-input::placeholder { color: #444; }
        .search-clear {
            background: transparent;
            border: none;
            color: #555;
            cursor: pointer;
            font-size: 0.85rem;
            padding: 0;
            line-height: 1;
            flex-shrink: 0;
        }
        .search-clear:hover { color: #e94560; }
        .search-info {
            font-size: 0.75rem;
            color: #555;
            font-style: italic;
            white-space: nowrap;
        }
        .row-hidden { display: none !important; }
        .row-highlight td:first-child {
            border-left: 2px solid #e94560 !important;
        }
        .btn-success-outline {
            background: transparent;
            color: #57ffb0;
            border: 1px solid #57ffb0;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.82rem;
            transition: background 0.2s, color 0.2s;
        }
        .btn-success-outline:hover {
            background: #57ffb0;
            color: #1a1a2e;
        }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<nav class="navbar">
    <span class="logo">📊</span>
    <input type="text" id="sheetTitle"
           value="@sheetTitleVal"
           placeholder="Название таблицы..."/>
    <button class="btn btn-success" onclick="saveSheet()">💾 Сохранить</button>
    <button class="btn btn-primary" onclick="openPrintDialog()">🖨 Печать  / PDF</button>
    <button class="btn btn-success-outline" onclick="exportToExcel()">
        📥 Экспорт Excel
    </button>
    <button class="btn btn-outline" onclick="addRow()">+ Строка</button>
    <button class="btn btn-outline" onclick="addCol()">+ Столбец</button>
    <div class="spacer"></div>
    <button class="theme-toggle-btn btn btn-outline"
            onclick="toggleTheme()" title="Сменить тему">☀️</button>
    <span class="status" id="statusText">Готово</span>
    <a href="/Support/Chat?email=@Uri.EscapeDataString(User.Identity!.Name)"
       class="btn btn-outline bell-editor" id="bell-btn-editor"
       title="Чат поддержки">
        🔔 <span id="bell-badge-editor" style="display:none;
        background:#e94560; color:white; font-size:0.65rem;
        font-weight:700; padding:1px 5px; border-radius:10px;
        margin-left:3px;">0</span>
    </a>
    <a href="/Profile" class="btn btn-outline">👤 Профиль</a>
    <a href="/Spreadsheet" class="btn btn-outline">← Назад</a>
</nav>

<div id="print-overlay" style="display:none">
    <div id="print-dialog">
        <div class="pd-title">🖨 Печать  / Экспорт PDF</div>

        <div class="pd-group">
            <label>Название документа</label>
            <input type="text" id="pd-doc-title"
                   placeholder="Май - 2ПР23"/>
        </div>

        <div class="pd-group">
            <label>Название заведения</label>
            <input type="text" id="pd-school"
                   placeholder="Сибирский ПТ"/>
        </div>

        <div class="pd-group">
            <label>Имя преподавателя</label>
            <input type="text" id="pd-teacher"
                   placeholder="Анастасия Дмитриевна"/>
        </div>

        <div class="pd-group">
            <label>Группа</label>
            <input type="text" id="pd-subject"
                   placeholder="2ПР23"/>
        </div>

        <div class="pd-row">
            <div class="pd-group" style="flex:1">
                <label>Дата</label>
                <input type="date" id="pd-date"/>
            </div>
            <div class="pd-group" style="flex:1">
                <label>Ориентация</label>
                <select id="pd-orientation">
                    <option value="landscape">Альбомная</option>
                    <option value="portrait">Книжная</option>
                </select>
            </div>
        </div>

        <div class="pd-group">
            <label>Какие листы печатать</label>
            <select id="pd-tabs">
                <option value="current">Только текущий лист</option>
                <option value="all">Все листы</option>
            </select>
        </div>

        <div class="pd-footer">
            <button class="btn btn-outline"
                    onclick="closePrintDialog()">Отмена</button>
            <button class="btn btn-outline"
                    onclick="executePrint()">🖨 Печать</button>
            <button class="btn btn-primary"
                    onclick="exportToPDF()">💾 Сохранить как PDF</button>
        </div>
    </div>
</div>

<div id="toolbar">
    <!-- Text Style -->
    <div class="tool-group">
        <button class="tool-btn" id="btn-bold" onclick="applyBold()" title="Жирный">
            <b>B</b>
        </button>
        <button class="tool-btn" id="btn-italic" onclick="applyItalic()" title="Курсив">
            <i>I</i>
        </button>
        <button class="tool-btn" id="btn-underline" onclick="applyUnderline()" title="Подчеркнутый">
            <u>U</u>
        </button>
    </div>

    <div class="tool-divider"></div>

    <!-- Font Size -->
