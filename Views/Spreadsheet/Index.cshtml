@model IEnumerable<TeacherReporter.Models.SpreadsheetModel>
@{
    ViewData["Title"] = "My Spreadsheets";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
    (function(){
        try {
            var t = localStorage.getItem('tr_theme') || 'dark';
            document.documentElement.className = 'theme-' + t;
        } catch(e) {}
    })();
</script>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>My Spreadsheets — TeacherReporter</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .navbar {
            background: #16213e;
            border-bottom: 1px solid #0f3460;
            padding: 14px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .navbar .logo { color: #e94560; font-size: 1.3rem; font-weight: bold; }
        .navbar .nav-right { display: flex; align-items: center; gap: 16px; }
        .navbar .user { color: #aaa; font-size: 0.85rem; }
        .btn {
            padding: 8px 18px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-primary { background: #e94560; color: white; }
        .btn-primary:hover { background: #c73652; }
        .btn-outline {
            background: transparent;
            color: #aaa;
            border: 1px solid #0f3460;
        }
        .btn-outline:hover { border-color: #e94560; color: #e94560; }
        .btn-danger { background: #3a1a1a; color: #e94560; border: 1px solid #e94560; }
        .btn-danger:hover { background: #e94560; color: white; }
        .container { max-width: 960px; margin: 40px auto; padding: 0 24px; }
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
        }
        .page-header h1 { font-size: 1.5rem; color: #e0e0e0; }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 18px;
        }
        
        .card {
            background: #16213e;
            border: 1px solid #0f3460;
            border-radius: 10px;
            padding: 22px;
            transition: border-color 0.2s;
        }
        .card:hover { border-color: #e94560; }
        .card-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #e0e0e0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .card-date { font-size: 0.78rem; color: #666; margin-bottom: 18px; }
        .card-actions { display: flex; gap: 8px; }
        .empty {
            text-align: center;
            color: #555;
            padding: 60px 0;
            grid-column: 1 / -1;
        }
        .empty p { margin-bottom: 20px; font-size: 1rem; }
        form { display: inline; }
        .bell-btn {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            border: 1px solid #0f3460;
            text-decoration: none;
            font-size: 1.1rem;
            transition: border-color 0.2s, background 0.2s;
            background: transparent;
        }
        .bell-btn:hover {
            border-color: #e94560;
            background: rgba(233,69,96,0.08);
        }
        .bell-btn.has-unread {
            border-color: #e94560;
            animation: bell-pulse 2s infinite;
        }
        .bell-badge {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #e94560;
            color: white;
            font-size: 0.6rem;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            line-height: 1;
        }
        @@keyframes bell-pulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(233,69,96,0.4); }
            50%       { box-shadow: 0 0 0 6px rgba(233,69,96,0); }
        }
        .btn-success-sm {
            background: transparent;
            color: #57ffb0;
            border: 1px solid #57ffb0;
            padding: 6px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.8rem;
            transition: background 0.2s, color 0.2s;
        }
        .btn-success-sm:hover {
            background: #57ffb0;
            color: #1a1a2e;
        }
    </style>
    <link rel="stylesheet" href="/css/themes.css"/>
    <script src="/js/theme.js"></script>
</head>
<body>

<script>
    (function(){
        var t = localStorage.getItem('tr_theme') || 'dark';
        document.body.className = 'theme-' + t;
    })();
</script>

<nav class="navbar">
    <div class="logo">📊 TeacherReporter</div>
    <div class="nav-right">
        <button class="theme-toggle-btn btn btn-outline"
                onclick="toggleTheme()" title="Переключить тему">☀️</button>
        <a href="/Support/Chat?email=@Uri.EscapeDataString(User.Identity!.Name)"
           class="bell-btn" id="bell-btn" title="Чат поддержки">
            🔔
            <span class="bell-badge" id="bell-badge" style="display:none">
                0
            </span>
        </a>
        <a href="/Profile/Index" class="user" style="text-decoration:none; color:#aaa;
   font-size:0.85rem; border:1px solid #0f3460; padding:5px 12px;
   border-radius:6px; transition: border-color 0.2s, color 0.2s;"
           onmouseover="this.style.borderColor='#e94560';this.style.color='#e94560'"
           onmouseout="this.style.borderColor='#0f3460';this.style.color='#aaa'">
            👤 @User.Identity!.Name
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a href="/Admin" class="btn btn-outline">Панель администратора</a>
        }
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline">Выйти</button>
        </form>
    </div>
</nav>

<div class="container">
    <div class="page-header">
        <h1>Мои таблицы</h1>
        <a href="/Spreadsheet/Templates" class="btn btn-primary">+ Новая таблица</a>
    </div>

    <div class="grid">
        @if (!Model.Any())
        {
            <div class="empty">
                <p>Таблиц пока нет.</p>
                <a href="/Spreadsheet/Templates" class="btn btn-primary">Создать первую таблицу</a>
            </div>
        }
        else
        {
            @foreach (var sheet in Model)
            {
                <div class="card">
                    <div class="card-title">@sheet.Title</div>
                    <div class="card-date">
                        Обновлено: @sheet.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    </div>
                    <div class="card-actions">
                        <a href="/Spreadsheet/Editor/@sheet.Id"
                           class="btn btn-primary">Открыть</a>
                        <button class="btn btn-success-sm"
                                onclick="exportSheetById(@sheet.Id, '@Html.Raw(sheet.Title.Replace("'", "\\'"))')">
                            📥 Excel
                        </button>
                        <form method="post" action="/Spreadsheet/Delete/@sheet.Id"
                              onsubmit="return confirm('Удалить эту таблицу?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">Удалить</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>
<script>
    function updateBell(count) {
        var btn   = document.getElementById('bell-btn');
        var badge = document.getElementById('bell-badge');
        if (!btn || !badge) return;

        if (count > 0) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.style.display = 'flex';
            btn.classList.add('has-unread');
            btn.title = count + ' непрочитанный ответ от администратора';
        } else {
            badge.style.display = 'none';
            btn.classList.remove('has-unread');
            btn.title = 'Чат поддержки';
        }
    }

    async function pollBell() {
        try {
            var res = await fetch('/Spreadsheet/UnreadSupportCount');
            if (!res.ok) return;
            var data = await res.json();
            updateBell(data.count);
        } catch (e) { }
    }

    // Poll immediately then every 15 seconds
    pollBell();
    setInterval(pollBell, 15000);
</script>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
    async function exportSheetById(id, title) {
        if (typeof XLSX === 'undefined') {
            alert('Библиотека Excel не загружена. Проверьте подключение к интернету.');
            return;
        }

        try {
            var res = await fetch('/Spreadsheet/GetData/' + id);
            if (!res.ok) throw new Error('Не удалось загрузить данные таблицы.');
            var data = await res.json();

            var parsed = null;
            try { parsed = JSON.parse(data.dataJson); }
            catch (e) { throw new Error('Неверные данные таблицы'); }

            var sheetTabs = [];
            if (parsed && parsed.tabs && parsed.tabs.length > 0) {
                sheetTabs = parsed.tabs;
            } else if (parsed && parsed.data && parsed.columns) {
                sheetTabs = [{
                    name: 'Sheet 1',
                    data: parsed.data,
                    columns: parsed.columns
                }];
            }

            if (!sheetTabs.length) {
                alert('Данные для экспорта отсутствуют.');
                return;
            }

            var wb = XLSX.utils.book_new();

            sheetTabs.forEach(function (tab) {
                var cols = tab.columns || [];
                var rows = tab.data    || [];
                var sheetData = [];

                rows.forEach(function (row) {
                    var r = row.map(function (cell) {
                        var val = cell !== null &&
                        cell !== undefined ? String(cell) : '';
                        val = val.trim();
                        // Skip raw formulas — export empty instead
                        if (val.startsWith('=')) return '';
                        
                        if (val === '#ERROR' || val.startsWith('#')) return '';
                        var num = parseFloat(val);
                        if (!isNaN(num) && isFinite(num) && val !== '')
                            return num;
                        return val;
                    });
                    sheetData.push(r);
                });

                var ws = XLSX.utils.aoa_to_sheet(sheetData);

                var colWidths = cols.map(function (c) {
                    var w = (c && c.width) ? c.width : 120;
                    return { wch: Math.round(w / 7) };
                });
                ws['!cols'] = colWidths;

                var sheetName = tab.name
                    .replace(/[:\\\/\?\*\[\]]/g, '')
                    .substring(0, 31) || 'Sheet';

                XLSX.utils.book_append_sheet(wb, ws, sheetName);
            });

            var filename = title
                .replace(/[^a-zA-Z0-9_\-\s\u0400-\u04FF]/g, '')
                .trim()
                .replace(/\s+/g, '_') || 'spreadsheet';

            XLSX.writeFile(wb, filename + '.xlsx');

        } catch (e) {
            alert('Экспорт не удался: ' + e.message);
        }
    }
</script>

@await Html.PartialAsync("_SessionWarning")

</body>
</html>